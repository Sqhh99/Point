    "verify:package": "node scripts/verify-package.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@point/core": "workspace:*",
    "@types/better-sqlite3": "^9.6.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "dompurify": "^3.4.16",
    "electron": "^32.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "js-yaml": "^4.3.2",
    "marked": "^18.1.0",
    "mermaid": "^12.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vite": "^5.4.9"
  },
  "description": "Point: read, explain and take notes on documents with AI",
